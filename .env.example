# Tony Stark — configuration
#
# Copy to `.env` and fill in the secrets. `.env` is gitignored — never commit keys.
# Every non-secret value below was verified live by `npm run spike:services`.

# ─── Network ────────────────────────────────────────────────────────────────
# Development happens on Sepolia; mainnet is for the final demo.
NETWORK=sepolia

STARKNET_RPC_URL=https://starknet-sepolia.drpc.org
# mainnet: https://rpc.starknet.lava.build

# ─── STRK20 privacy pool ────────────────────────────────────────────────────
# Verified on-chain (see scripts/spikes/check-services.mjs).
# sepolia — class hash 0x56ab118a8a6e38efc93ad758cefe909fee421fa931ce3cf72df624d345623b2
POOL_ADDRESS=0x254a6b2997ef52e9f830ce1f543f6b29768295e8d17e2267d672c552cfe0d91
# mainnet — class hash 0x67dddd89d80fedadc06b6f160798f94800a4a70164e5a24301cd0d6076b554d
# POOL_ADDRESS=0x040337b1af3c663e86e333bab5a4b28da8d4652a15a69beee2b677776ffe812a

# ─── Privacy services ───────────────────────────────────────────────────────
# StarkWare's hosted Sepolia infrastructure — live, OHTTP-enabled, and free.
# Verified official: /ohttp-keys byte-matches the config pinned in starknet-privacy.
PROVING_SERVICE_URL=https://transaction-prover.alpha-sepolia.sw-dev.io
INDEXER_URL=https://discovery-service.alpha-sepolia.sw-dev.io

# Enable Oblivious HTTP so the service operator cannot link your IP to your
# queries. Keep this ON — it is a load-bearing part of the privacy model.
OHTTP_ENABLED=true

# ─── Account (SECRETS — never commit) ───────────────────────────────────────
ACCOUNT_ADDRESS=
ACCOUNT_PRIVATE_KEY=
# Pool viewing key. Whoever holds this can read your private history.
VIEWING_KEY=

# ─── Tokens ─────────────────────────────────────────────────────────────────
# STRK is the fee token; same address across networks.
STRK_TOKEN_ADDRESS=0x04718f5a0fc34cc1af16a1cdee98ffb20c31f5cd61d6ab07201858f4287c938d

# ─── AVNU paymaster (gasless + fee privacy) ─────────────────────────────────
# `sponsored_private` pays the fee from inside the pool, so settling does not
# expose the payer. Optional until Phase 3.
PAYMASTER_URL=
AVNU_API_KEY=

# ─── Browser worker ─────────────────────────────────────────────────────────
TOR_SOCKS_PROXY=socks5://127.0.0.1:9050

# Tony Stark — configuration
#
# Copy to `.env` and fill in the secrets. `.env` is gitignored — never commit keys.
# Every non-secret value below was verified live by `npm run spike:services`.

# ─── Network ────────────────────────────────────────────────────────────────
# Development happens on Sepolia; mainnet is for the final demo.
NETWORK=sepolia

STARKNET_RPC_URL=https://starknet-sepolia.drpc.org
# mainnet: https://rpc.starknet.lava.build

# ─── STRK20 privacy pool ────────────────────────────────────────────────────
# Verified on-chain (see scripts/spikes/check-services.mjs).
# sepolia — class hash 0x56ab118a8a6e38efc93ad758cefe909fee421fa931ce3cf72df624d345623b2
POOL_ADDRESS=0x254a6b2997ef52e9f830ce1f543f6b29768295e8d17e2267d672c552cfe0d91
# mainnet — class hash 0x67dddd89d80fedadc06b6f160798f94800a4a70164e5a24301cd0d6076b554d
# POOL_ADDRESS=0x040337b1af3c663e86e333bab5a4b28da8d4652a15a69beee2b677776ffe812a

# ─── Privacy services ───────────────────────────────────────────────────────
# StarkWare's hosted Sepolia infrastructure — live, OHTTP-enabled, and free.
# Verified official: /ohttp-keys byte-matches the config pinned in starknet-privacy.
PROVING_SERVICE_URL=https://transaction-prover.alpha-sepolia.sw-dev.io
INDEXER_URL=https://discovery-service.alpha-sepolia.sw-dev.io

# Oblivious HTTP for the SDK's prover/discovery calls. The MCP server passes
# this through to both providers, so the proving operator reads neither the
# request nor the response. Set to "false" to fall back to plain HTTPS.
OHTTP_ENABLED=true

# Optional OHTTP relay. Without one you get confidentiality but NOT
# unlinkability: the gateway still sees your connection. The relay/gateway
# split is what hides the client IP. See docs/THREAT-MODEL.md 3.5.
OHTTP_RELAY_URL=

# ─── Account (SECRETS — never commit) ───────────────────────────────────────
ACCOUNT_ADDRESS=
ACCOUNT_PRIVATE_KEY=
# Pool viewing key. Whoever holds this can read your private history.
VIEWING_KEY=
# The client derives the viewing key from this passphrase, so callers never
# handle the key itself. Changing it changes which notes you can see.
PRIVACY_PASSPHRASE=tony-stark-sepolia-dev

# ─── Tokens ─────────────────────────────────────────────────────────────────
# STRK is the fee token; same address across networks.
STRK_TOKEN_ADDRESS=0x04718f5a0fc34cc1af16a1cdee98ffb20c31f5cd61d6ab07201858f4287c938d

# ─── AVNU paymaster (REQUIRED — the submission path) ────────────────────────
# Not optional: this is the only way a server-side agent can submit a proven
# transaction. `sponsored_private` also pays the fee from inside the pool, so
# settling doesn't expose the payer. Get a key at https://portal.avnu.fi
PAYMASTER_URL=https://sepolia.paymaster.avnu.fi
AVNU_API_KEY=

# ─── Local MCP browsing (Tor required) ──────────────────────────────────────
# The local MCP server fetches public HTTP(S) URLs through Tor.
TOR_SOCKS_PROXY=socks5://127.0.0.1:9050

# OHTTP is active only when all three remote values are configured.
# A local relay and gateway are protocol-test infrastructure, not anonymity.
OHTTP_RELAY_URL=
OHTTP_GATEWAY_URL=
OHTTP_GATEWAY_KEY_CONFIG=
